# --- Root Ignore ---
# Ignore everything at root
/*

# --- Unignore Special Files ---
!/.gitignore
!/README.md
!/AGENTS.md
!/Docs/
!/Docs/**
!/WorkDemoServer/
!/WorkDemoServer/**
/WorkDemoServer/bin/
/WorkDemoServer/obj/
/WorkDemoServer/Data/

# --- Unignore Assets Structure ---
!/Assets/

# --- Ignore Everything inside Assets ---
/Assets/*

# --- Unignore Specific Assets Folders ---
!/Assets/Scripts/
!/Assets/Editor Default Resources/

# --- Ignore Everything inside Scripts ---
/Assets/Scripts/*

# --- Unignore Specific Script Folders ---
!/Assets/Scripts/GameCore/
!/Assets/Scripts/Manager/
!/Assets/Scripts/Utils/
!/Assets/Resources/
# 只提交 Resources 下的 GameData 配置，忽略其余美术/第三方/大体积二进制资源
/Assets/Resources/*
!/Assets/Resources/GameData.meta
!/Assets/Resources/GameData/
!/Assets/Resources/GameData/**

# --- Unity Standard Ignores (Just in case specific rules leak) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
.vs/
.gradle/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties
